<resources>
    <!-- The location of the devices physical tri state switch
         0: Left side
         1: Right side -->
    <integer name="config_alertSliderLocation">0</integer>

    <!-- Key handler broadcast when changing slider position -->
    <string name="config_alertSliderIntent" translatable="false"></string>

    <!-- Use Oplus GLES charging ring (libnativeChargingRing) when the .so and textures are present. -->
    <bool name="config_chargingAnimUseStockVfx">true</bool>

    <!-- Optional overlays for the SuperVOOC ring: the wordmark and the slanted wattage pill. -->
    <array name="config_chargingAnimLogo"/>
    <array name="config_chargingAnimWattageBg"/>

    <bool name="config_rrSeparateSimIcons">false</bool>
</resources>
